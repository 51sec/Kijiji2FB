{
  "manifest_version": 3,
  "name": "Kijiji → Facebook Marketplace Sync",
  "version": "0.1.0",
  "description": "Capture a Kijiji ad with one click and auto-fill it into a new Facebook Marketplace listing.",
  "permissions": ["storage", "activeTab", "tabs", "unlimitedStorage", "debugger"],
  "host_permissions": [
    "https://www.kijiji.ca/*",
    "https://media.kijiji.ca/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kijiji → FB Marketplace"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kijiji.ca/v-*"],
      "js": ["content-kijiji.js"],
      "css": ["content-kijiji.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/create/*"],
      "js": ["content-facebook.js"],
      "run_at": "document_idle"
    }
  ]
}
